<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 30 and below (API 31+ uses data_extraction_rules.xml).
   An empty rule set means "back everything up", so every exclusion here has to
   be stated explicitly.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
      Captured false-trigger audio (WakeCaptureStore) and captured commands
      (UtteranceCaptureStore). These are microphone recordings of the user's
      home, and the settings page promises they never leave the device. Backing
      them up would copy them to Google's servers, so they are excluded here
      and in data_extraction_rules.xml.
    -->
    <exclude domain="file" path="wake-captures/" />
    <exclude domain="file" path="utterance-captures/" />
</full-backup-content>
