<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for API 31+. An empty rule set means
   "extract everything", so every exclusion has to be stated explicitly, and
   both transports need saying separately — device-to-device transfer has no
   size quota at all, so a new-phone migration would otherwise copy everything.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          Captured false-trigger audio (WakeCaptureStore) and captured commands
          (UtteranceCaptureStore). Microphone recordings of the user's home.
          Contributing them is an explicit, per-category choice on the
          Recordings page; a cloud backup is not that choice. Never upload them.
        -->
        <exclude domain="file" path="wake-captures/" />
        <exclude domain="file" path="wake-captures-rejected/" />
        <exclude domain="file" path="wake-captures-accepted/" />
        <exclude domain="file" path="utterance-captures/" />
        <!--
          Deliberately recorded wake-phrase audio (WakeSampleStore). Named
          recordings of the household. More sensitive than the buffers above.
        -->
        <exclude domain="file" path="wake-samples/" />
        <!--
          API keys and OAuth tokens (SecretStore). Excluded for two reasons
          and either would do: they are the user's credentials, and the
          AES-256-GCM key encrypting them lives in the Android Keystore, which
          is never backed up. Restoring the file alone yields ciphertext
          nothing can read.
        -->
        <exclude domain="sharedpref" path="ari_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Same audio, same promise — and no quota to hide behind here. -->
        <exclude domain="file" path="wake-captures/" />
        <exclude domain="file" path="wake-captures-rejected/" />
        <exclude domain="file" path="wake-captures-accepted/" />
        <exclude domain="file" path="utterance-captures/" />
        <exclude domain="file" path="wake-samples/" />
        <!-- Same credentials — and the Keystore key doesn't move either. -->
        <exclude domain="sharedpref" path="ari_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
