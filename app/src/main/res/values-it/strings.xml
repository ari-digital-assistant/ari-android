    <!-- Permissions section (used by onboarding + settings) -->
    <string name="permission_microphone_label">Microfono</string>
    <string name="permission_microphone_description">Necessario per la parola di attivazione e l\'input vocale</string>
    <string name="permission_notifications_label">Notifiche</string>
