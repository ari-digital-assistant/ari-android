    <!-- Onboarding -->
    <string name="onboarding_language_title">Scegli la tua lingua</string>
    <string name="onboarding_language_body">Scegli la lingua in cui Ari ti ascolterà e risponderà. Puoi cambiarla in qualsiasi momento dalle impostazioni.</string>
    <string name="onboarding_language_continue">Continua</string>
    <string name="onboarding_welcome_title">Benvenuto su Ari!</string>
    <string name="onboarding_welcome_title_revisit">Bentornato!</string>
    <string name="onboarding_welcome_body">Ari è un assistente digitale open-source che mette al primo posto la tua privacy. Questa procedura guidata ti aiuterà a configurarlo. Puoi sempre modificare queste impostazioni in seguito, o rilanciare la procedura dal menù.</string>
