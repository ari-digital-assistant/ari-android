    <!-- Settings section blurbs -->
    <string name="settings_wakeword_blurb">La frase a cui Ari risponde. \"Hey Jarvis\" è il modello microWakeWord originale, incluso come fallback.</string>
    <string name="settings_wakeword_sensitivity_blurb">Sensibilità — quanto facilmente Ari risponde alla tua voce. Se Ari si attiva quando non dovrebbe, abbassa il valore. Se non si attiva quando vuoi, alzalo.</string>
    <string name="wakeword_sensitivity_high_label">Alta</string>
    <string name="wakeword_sensitivity_high_description">Si attiva facilmente. Usa solo in ambienti molto silenziosi.</string>
    <string name="wakeword_sensitivity_medium_label">Media</string>
    <string name="wakeword_sensitivity_medium_description">Consigliata per la maggior parte degli ambienti.</string>
    <string name="wakeword_sensitivity_low_label">Bassa</string>
    <string name="wakeword_sensitivity_low_description">Più rigorosa. Usa se Ari si attiva quando non dovrebbe.</string>
    <string name="settings_wake_capture_title">Conserva l\'audio delle attivazioni errate</string>
    <string name="settings_wake_capture_blurb">Quando Ari si attiva per qualcosa che non hai detto, conserva la registrazione per migliorare la parola di attivazione. L\'audio resta su questo dispositivo, nella memoria privata di Ari, non viene mai caricato online ed è limitato a 50 clip. Disattivato per impostazione predefinita.</string>
    <string name="settings_wake_capture_stats">%1$d clip · %2$s</string>
    <string name="settings_wake_capture_empty">Nessuna clip salvata.</string>
    <string name="settings_wake_capture_delete">Elimina tutte le clip</string>
    <string name="settings_stt_models_blurb">Scegli un modello di riconoscimento vocale. I modelli più grandi sono più accurati ma occupano più spazio e RAM.</string>
    <string name="settings_language_blurb">La lingua in cui Ari ascolta e parla. Cambiarla aggiorna le risposte dell\'assistente e i testi dell\'app — potresti dover sostituire il modello di riconoscimento vocale qui sotto se non supporta la nuova lingua.</string>
    <string name="settings_cloud_stt_for_non_english_title">Usa STT cloud per le lingue non inglesi</string>
    <string name="settings_cloud_stt_for_non_english_blurb">Se attivo, la voce non in inglese viene trascritta dall\'assistente cloud configurato invece che dal modello Whisper sul dispositivo. Più veloce sui telefoni lenti, ma il tuo audio lascia il dispositivo. Non ha effetto se non hai configurato un assistente cloud.</string>
    <string name="settings_start_on_boot_title">Avvia Ari all\'accensione</string>
    <string name="settings_start_on_boot_blurb">Quando il dispositivo si avvia, Ari inizierà ad ascoltare la parola di attivazione automaticamente. Consuma un po\' più di batteria poiché il microfono resta sempre attivo — lascia disattivato se preferisci avviare Ari manualmente.</string>
    <string name="settings_default_assistant_title">Assistente digitale predefinito</string>
    <string name="settings_default_assistant_blurb">Imposta Ari come assistente digitale predefinito per poterlo richiamare con il gesto di assist (pressione lunga su tasto Home o accensione).</string>
    <string name="settings_llm_blurb">Scegli un modello linguistico sul dispositivo. Quando attivo, Ari può rispondere a domande generiche e instradare i comandi mal compresi allo skill giusto. I modelli più grandi danno risposte migliori ma occupano più spazio e RAM.</string>
