    <string name="onboarding_permissions_title">Autorizzazioni</string>
    <string name="onboarding_permissions_body">Ari funziona meglio con queste autorizzazioni. Tocca per concedere o gestirle.</string>
    <string name="onboarding_permissions_missing_title">Continuare senza autorizzazioni?</string>
    <string name="onboarding_permissions_missing_mic">Non potrai usare la parola di attivazione né l\'input vocale. Potrai comunque scrivere.</string>
    <string name="onboarding_permissions_missing_notifications">Ari non potrà mostrarti cosa sta facendo quando ascolta in background.</string>
    <string name="onboarding_permissions_missing_overlay">La parola di attivazione funzionerà solo una volta per sessione quando il telefono è bloccato.</string>
    <string name="onboarding_permissions_stay">Rimani e concedi</string>
    <string name="onboarding_permissions_continue">Continua comunque</string>

    <string name="onboarding_wakeword_title">Parola di attivazione</string>
    <string name="onboarding_wakeword_body">Pronunciala per attivare Ari. Scegli una frase e la sensibilità con cui Ari dovrà ascoltarla.</string>
    <string name="onboarding_wakeword_start_listening">Inizia ad ascoltare ora</string>
    <string name="onboarding_wakeword_start_listening_help">Ari inizierà ad ascoltare subito. Puoi anche scegliere di avviare Ari all\'accensione dalla schermata Generali — sono due interruttori distinti.</string>

    <string name="onboarding_stt_title">Riconoscimento vocale</string>
    <string name="onboarding_stt_body">Ari trascrive la tua voce sul dispositivo. <b>L\'audio non lascia mai il telefono.</b></string>
    <string name="onboarding_stt_continue_hint">Puoi continuare — il download finirà in background.</string>

    <string name="onboarding_assistant_title">Assistente</string>
    <string name="onboarding_assistant_body">Ari usa gli skill per rispondere alla maggior parte delle richieste. Per il resto, puoi scegliere un assistente — oppure no.</string>
    <string name="onboarding_assistant_none">Nessuno</string>
    <string name="onboarding_assistant_none_blurb">Nessun assistente IA. Ari risponderà solo a comandi diretti e non cercherà di interpretare il linguaggio naturale.</string>
    <string name="onboarding_assistant_none_pro_1">Tempo di risposta più rapido</string>
    <string name="onboarding_assistant_none_pro_2">Funziona completamente offline</string>
    <string name="onboarding_assistant_none_pro_3">Niente da configurare</string>
    <string name="onboarding_assistant_none_con_1">Ari ti dirà quando non può aiutarti</string>
    <string name="onboarding_assistant_ondevice">Su dispositivo</string>
    <string name="onboarding_assistant_ondevice_blurb">Ari userà modelli IA locali per interpretare i tuoi comandi. Non richiede connessione internet, ma può avere capacità limitate rispetto agli assistenti cloud, a seconda del modello scelto.</string>
    <string name="onboarding_assistant_ondevice_pro_1">100% privato — niente lascia il tuo telefono</string>
    <string name="onboarding_assistant_ondevice_pro_2">Niente account, niente API key, niente internet</string>
    <string name="onboarding_assistant_ondevice_con_1">Più piccolo e meno capace degli assistenti cloud</string>
    <string name="onboarding_assistant_ondevice_con_2">Usa più batteria e spazio</string>
    <string name="onboarding_assistant_cloud">Cloud</string>
    <string name="onboarding_assistant_cloud_blurb">Usa un servizio cloud per rispondere alle domande.</string>
    <string name="onboarding_assistant_cloud_pro_1">Potente e versatile</string>
    <string name="onboarding_assistant_cloud_pro_2">Gestisce un\'ampia gamma di richieste</string>
    <string name="onboarding_assistant_cloud_con_1">Richiede internet</string>
    <string name="onboarding_assistant_cloud_con_2">I messaggi di testo vengono inviati a un servizio cloud</string>
    <string name="onboarding_assistant_cloud_con_3">Può richiedere una API key o un account</string>
    <string name="onboarding_assistant_cloud_privacy">La tua voce viene trascritta sul dispositivo. Solo il testo viene inviato al servizio cloud. Ari non invia mai audio a terzi.</string>
    <string name="onboarding_assistant_cloud_later">Gli assistenti cloud si installano come skill. Ari supporta vari provider come ChatGPT, Claude e Gemini. Puoi sfogliarli e installare quello che preferisci dalla schermata Skill dopo la configurazione.</string>
    <string name="onboarding_assistant_router_note">Ari scaricherà anche un piccolo modello di routing intelligente (~253 MB) in background, in modo da poter comprendere i comandi formulati in modi diversi.</string>

