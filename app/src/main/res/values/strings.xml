    <!-- Settings section blurbs -->
    <string name="settings_wakeword_blurb">The phrase Ari listens for. \"Hey Jarvis\" is the original microWakeWord model and is included as a fallback.</string>
    <string name="settings_wakeword_sensitivity_blurb">Sensitivity — how eagerly Ari responds to your voice. If Ari activates when it shouldn\'t, lower this. If it doesn\'t activate when you want it to, raise this.</string>
    <string name="wakeword_sensitivity_high_label">High</string>
    <string name="wakeword_sensitivity_high_description">Fires easily. Use only in very quiet rooms.</string>
    <string name="wakeword_sensitivity_medium_label">Medium</string>
    <string name="wakeword_sensitivity_medium_description">Recommended for most environments.</string>
    <string name="wakeword_sensitivity_low_label">Low</string>
    <string name="wakeword_sensitivity_low_description">Stricter. Use if Ari wakes when it shouldn\'t.</string>
    <string name="settings_wake_capture_title">Keep false-trigger audio</string>
    <string name="settings_wake_capture_blurb">When Ari wakes for something you didn\'t say, keep the recording so the wake word can be improved. Audio stays on this device in Ari\'s private storage, is never uploaded, and is capped at 50 clips per capture category. Off by default.</string>
    <plurals name="settings_capture_stats">
        <item quantity="one">%1$d clip · %2$s</item>
        <item quantity="other">%1$d clips · %2$s</item>
    </plurals>
    <string name="settings_capture_empty">No clips saved yet.</string>
    <string name="settings_capture_delete">Delete all clips</string>
    <string name="settings_capture_export">Export clips</string>
    <string name="settings_wake_capture_export_chooser">Export wake-word clips</string>
    <string name="settings_utterance_capture_title">Keep command recordings</string>
    <string name="settings_utterance_capture_blurb">Keep a recording of everything you say to Ari, next to every transcript the recogniser produced for it, so mis-hearings can be traced back to the audio. Recordings stay on this device in Ari\'s private storage, are never uploaded, and are capped at 100 clips. Off by default.</string>
    <string name="settings_utterance_capture_export_chooser">Export command recordings</string>
    <string name="settings_stt_models_blurb">The speech model for your language. Downloaded once, then it works offline.</string>
    <string name="settings_language_blurb">The language Ari listens and speaks in. Changing this updates the assistant\'s replies and the app\'s chrome — you may need to swap your speech-to-text model below if it doesn\'t support the new language.</string>
    <string name="settings_stt_mode_on_device_title">On device</string>
    <string name="settings_stt_mode_on_device_blurb">Transcribes on your phone. Works offline.</string>
    <string name="settings_stt_mode_openai_title">OpenAI</string>
    <string name="settings_stt_mode_openai_blurb">Most accurate. Needs an API key and a connection.</string>
    <string name="settings_stt_mode_self_hosted_title">Self-hosted Whisper</string>
    <string name="settings_stt_mode_self_hosted_blurb">Your own server. Accurate, and your audio stays on your network.</string>
    <string name="settings_stt_openai_blurb">Paste your OpenAI API key. Nothing else to set up.</string>
    <string name="settings_stt_self_hosted_blurb">Any OpenAI-compatible transcription endpoint — whisper.cpp, faster-whisper, or Home Assistant\'s Whisper add-on.</string>
    <string name="settings_stt_cloud_endpoint_label">Endpoint URL</string>
    <string name="settings_stt_cloud_model_label">Model name</string>
    <string name="settings_stt_cloud_api_key_label">API key</string>
    <string name="settings_stt_cloud_api_key_hint_required">Required. Create one in your OpenAI account.</string>
    <string name="settings_stt_cloud_api_key_hint_optional">Optional. Most self-hosted servers don\'t need one.</string>
    <string name="settings_start_on_boot_title">Start Ari on boot</string>
    <string name="settings_start_on_boot_blurb">When your device boots, Ari will start listening for the wake word automatically. Uses a bit more battery since the microphone is always on — leave it off if you\'d rather start Ari manually.</string>
    <string name="settings_default_assistant_title">Default digital assistant</string>
    <string name="settings_default_assistant_blurb">Set Ari as your default digital assistant so it can be invoked with the assist gesture (long-press home button or power button).</string>
    <string name="settings_llm_blurb">Choose an on-device language model. When enabled, Ari can answer general questions and reroute misheard commands to the right skill. Larger models give better answers but use more storage and RAM.</string>
    <string name="settings_llm_none_title">None</string>
    <string name="settings_llm_none_blurb">No on-device LLM. Ari only answers via matched skills.</string>
