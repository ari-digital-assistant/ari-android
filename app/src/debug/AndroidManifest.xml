<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay: attaches the cleartext-permitting
  network security config to the application. Merged on top of the
  main manifest only for the debug build variant. Release builds use
  the platform default (HTTPS-only).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig">

        <!--
          Issue #19 probe: measures whether the platform location stack is
          throttled while Ari's microphone FGS is up. Exported so it can be
          driven from `adb shell am broadcast`, which is the whole point of
          it; debug-only, so nothing exported here ever ships.
        -->
        <receiver
            android:name="dev.heyari.ari.debug.LocationProbeReceiver"
            android:exported="true" />
    </application>
</manifest>
