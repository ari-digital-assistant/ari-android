<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config: allow cleartext HTTP for the
  emulator's host-loopback alias (10.0.2.2) so smoke tests can talk to
  a fixture HTTP server running on the developer machine. Release
  builds use the platform default (HTTPS-only) because this file is
  not in the main source set.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
